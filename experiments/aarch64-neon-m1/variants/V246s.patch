+/// Returns the successors of the lanes of x: `step_up_where` with m set in every
+/// lane. The lanes whose result is used must be finite and must not be -0; the
+/// others get some bit pattern, as the integer operations cannot trap.
+#[inline(always)]
+pub(super) fn step_up_all(x: F64X2) -> F64X2 {
+    // `step_up_where` with m = -1, where m ^ n = !n.
+    let n = lt(x, zero());
+    add_i64(sub_i64(x, not(n)), n)
+}
